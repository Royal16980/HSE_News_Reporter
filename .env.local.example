# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=UK Health & Safety News

# n8n Integration
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_URL=https://n8n.srv1246730.hstgr.cloud/webhook/
N8N_SOCIAL_WEBHOOK_URL=https://n8n.srv1246730.hstgr.cloud/webhook/article-published

# Webhook Security (Generate random strings for these)
WEBHOOK_SECRET=generate_random_string_here
REVALIDATE_SECRET=generate_another_random_string

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Newsletter (Optional - for future integration)
NEWSLETTER_API_KEY=your_newsletter_service_api_key

# Push Notifications (Optional)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key

# Social Media APIs (Optional - for n8n workflows)
LINKEDIN_ACCESS_TOKEN=your_linkedin_token
TWITTER_API_KEY=your_twitter_key
TWITTER_API_SECRET=your_twitter_secret
