    {
      "parameters": {
        "functionCode": "const allPosts = $input.all();\n\nconst summary = {\n  article_id: $('Format Platform-Specific Posts').item.json.article_id,\n  article_title: $('Format Platform-Specific Posts').item.json.title,\n  platforms_posted: allPosts.length,\n  timestamp: new Date().toISOString(),\n  linkedin_success: allPosts.some(p => p.json.platform === 'linkedin'),\n  twitter_success: allPosts.some(p => p.json.platform === 'twitter'),\n  facebook_success: allPosts.some(p => p.json.platform === 'facebook')\n};\n\nconsole.log('Social Media Distribution Summary:', summary);\n\nreturn [{ json: summary }];"
      },
      "id": "create-summary",
      "name": "Create Summary",
      "type": "n8n-nodes-base.code",
