{
  "name": "4. Social Media Distribution",
  "nodes": [
    {
      "parameters": {
        "path": "webhook/article-published",
        "options": {
          "rawBody": false
        },
        "responseMode": "responseNode",
        "authentication": "headerAuth"
      },
      "id": "webhook-trigger",
      "name": "Article Published Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 400],
      "webhookId": "article-published",
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Webhook Secret Auth"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const data = $input.item.json.body;\n\n// LinkedIn post format (max 3000 chars, but keep concise)\nconst linkedInPost = `${data.title}\n\n${data.excerpt}\n\nRead the full article: ${data.url}\n\n#HealthAndSafety #WorkplaceSafety #HSE #UKSafety #${data.category.replace(/\\s+/g, '')}`;\n\n// Twitter/X format (max 280 chars)\nconst twitterPost = `${data.title.substring(0, 200)}...\n\n${data.url}\n\n#HSE #WorkplaceSafety`;\n\n// Facebook post format (more casual, longer)\nconst facebookPost = `📢 New Article: ${data.title}\n\n${data.excerpt}\n\nStay informed about the latest in UK Health & Safety regulations and best practices.\n\n👉 Read more: ${data.url}\n\n#HealthAndSafety #WorkplaceSafety #UKSafety`;\n\nreturn {\n  json: {\n    ...data,\n    linkedin_post: linkedInPost,\n    twitter_post: twitterPost,\n    facebook_post: facebookPost\n  }\n};"
      },
      "id": "format-posts",
      "name": "Format Platform-Specific Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 400]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "create",
        "text": "={{ $json.linkedin_post }}",
        "additionalFields": {
          "visibility": "PUBLIC"
        }
      },
      "id": "post-linkedin",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [650, 200],
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "4",
          "name": "LinkedIn OAuth2"
        }
      }
    },
    {
      "parameters": {
        "resource": "tweet",
        "operation": "create",
        "text": "={{ $json.twitter_post }}"
      },
      "id": "post-twitter",
      "name": "Post to Twitter/X",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 2,
      "position": [650, 400],
      "credentials": {
        "twitterOAuth2Api": {
          "id": "5",
          "name": "Twitter OAuth2"
        }
      }
    },
    {
      "parameters": {
        "resource": "page",
        "operation": "post",
        "pageId": "={{ $env.FACEBOOK_PAGE_ID }}",
        "content": "={{ $json.facebook_post }}",
        "additionalFields": {
          "link": "={{ $json.url }}"
        }
      },
      "id": "post-facebook",
      "name": "Post to Facebook Page",
      "type": "n8n-nodes-base.facebook",
      "typeVersion": 1,
      "position": [650, 600],
      "credentials": {
        "facebookGraphApi": {
          "id": "6",
          "name": "Facebook Graph API"
        }
      }
    },
