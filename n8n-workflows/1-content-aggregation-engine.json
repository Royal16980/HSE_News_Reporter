      "id": "if-not-exists",
      "name": "If Not Duplicate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "functionCode": "// Fetch full article content via HTTP request\nconst url = $input.item.json.url;\n\nconst response = await fetch(url);\nconst html = await response.text();\n\n// Extract main content (basic extraction - adjust selectors as needed)\nconst parser = new DOMParser();\nconst doc = parser.parseFromString(html, 'text/html');\n\n// Try common article content selectors\nlet content = '';\nconst selectors = [\n  'article',\n  '.article-content',\n  '.post-content',\n  '.entry-content',\n  'main'\n];\n\nfor (const selector of selectors) {\n  const element = doc.querySelector(selector);\n  if (element) {\n    content = element.textContent.trim();\n    break;\n  }\n}\n\n// If no content found, use excerpt\nif (!content) {\n  content = $input.item.json.excerpt;\n}\n\n// Clean content\ncontent = content.replace(/\\s+/g, ' ').trim();\n\n// Extract images\nconst images = [];\nconst imgElements = doc.querySelectorAll('img');\nfor (const img of imgElements) {\n  const src = img.getAttribute('src');\n  if (src && (src.startsWith('http') || src.startsWith('//'))) {\n    images.push(src.startsWith('//') ? 'https:' + src : src);\n  }\n}\n\nreturn {\n  json: {\n    ...($input.item.json),\n    full_content: content,\n    images: images,\n    word_count: content.split(/\\s+/).length,\n    reading_time: Math.ceil(content.split(/\\s+/).length / 200)\n  }\n};"
      },
      "id": "fetch-full-content",
      "name": "Fetch Full Article Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300]
    },
