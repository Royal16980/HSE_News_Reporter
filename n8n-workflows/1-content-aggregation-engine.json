    {
      "parameters": {
        "url": "https://www.shponline.co.uk/feed/",
        "options": {}
      },
      "id": "shp-rss",
      "name": "SHP Online RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 600]
    },
    {
      "parameters": {
        "functionCode": "const items = [];\n\nfor (const item of $input.all()) {\n  const body = item.json.body || item.json;\n  \n  // Parse RSS/HTML based on source\n  let articles = [];\n  \n  if (typeof body === 'string') {\n    // RSS Feed parsing\n    const parser = new DOMParser();\n    const xmlDoc = parser.parseFromString(body, 'text/xml');\n    const itemNodes = xmlDoc.getElementsByTagName('item');\n    \n    for (const node of itemNodes) {\n      const titleNode = node.getElementsByTagName('title')[0];\n      const linkNode = node.getElementsByTagName('link')[0];\n      const descNode = node.getElementsByTagName('description')[0];\n      const pubDateNode = node.getElementsByTagName('pubDate')[0];\n      \n      if (titleNode && linkNode) {\n        articles.push({\n          title: titleNode.textContent.trim(),\n          url: linkNode.textContent.trim(),\n          excerpt: descNode ? descNode.textContent.trim().replace(/<[^>]*>/g, '').substring(0, 300) : '',\n          published_date: pubDateNode ? new Date(pubDateNode.textContent).toISOString() : new Date().toISOString(),\n          source: item.json.source || 'Unknown'\n        });\n      }\n    }\n  } else if (body.items && Array.isArray(body.items)) {\n    // JSON API response\n    articles = body.items.map(article => ({\n      title: article.title || '',\n      url: article.link || article.url || '',\n      excerpt: article.description || article.summary || '',\n      published_date: article.pubDate || article.published || new Date().toISOString(),\n      source: item.json.source || 'Unknown'\n    }));\n  }\n  \n  // Only include articles from last 7 days\n  const sevenDaysAgo = new Date();\n  sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);\n  \n  articles = articles.filter(article => {\n    const pubDate = new Date(article.published_date);\n    return pubDate >= sevenDaysAgo;\n  });\n  \n  items.push(...articles.map(article => ({ json: article })));\n}\n\nreturn items;"
      },
      "id": "parse-content",
      "name": "Parse & Extract Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 400]
    },
