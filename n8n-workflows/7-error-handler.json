      },
      "id": "mark-needs-intervention",
      "name": "Mark Needs Manual Intervention",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1250, 600],
      "credentials": {
        "supabaseApi": {
          "id": "1",
          "name": "Supabase HSE News"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ \n  success: true, \n  error_id: $('Classify Error').item.json.error_id,\n  severity: $('Classify Error').item.json.severity,\n  logged: true\n}) }}"
      },
      "id": "respond-success",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1450, 600]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "id": "schedule-cleanup",
      "name": "Every 6 Hours (Cleanup)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 800]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Delete resolved errors older than 30 days\nDELETE FROM error_logs\nWHERE resolved = true\n  AND occurred_at < NOW() - INTERVAL '30 days';\n\n-- Get stats on cleanup\nSELECT \n  COUNT(*) FILTER (WHERE resolved = true) as resolved_count,\n  COUNT(*) FILTER (WHERE resolved = false AND requires_manual_intervention = true) as needs_attention,\n  COUNT(*) FILTER (WHERE severity = 'critical') as critical_count\nFROM error_logs\nWHERE occurred_at >= NOW() - INTERVAL '7 days';"
      },
      "id": "cleanup-old-errors",
      "name": "Cleanup Old Error Logs",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [450, 800],
      "credentials": {
        "supabaseApi": {
          "id": "1",
          "name": "Supabase HSE News"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const stats = $input.item.json[0] || {};\n\nconsole.log('Error Log Cleanup Summary:');\nconsole.log('- Resolved errors (last 7d):', stats.resolved_count);\nconsole.log('- Needs attention:', stats.needs_attention);\nconsole.log('- Critical errors:', stats.critical_count);\n\nif (stats.needs_attention > 0) {\n  console.warn(`⚠️ ${stats.needs_attention} errors require manual intervention`);\n}\n\nreturn { json: stats };"
      },
      "id": "log-cleanup",
      "name": "Log Cleanup Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 800]
    }
  ],
